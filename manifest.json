{
  "id": "com.vibe.selectiongen",
  "name": "选区生图",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "选区生图" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 360, "height": 720 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon@1x.png",
      "scale": [1],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["pluginList", "generic"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon@2x.png",
      "scale": [2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["pluginList", "generic"]
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "fullAccess"
  }
}
